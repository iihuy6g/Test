{% set is_kw = theme.settings.get('store_country', 'QA') == 'KW' %}
{% set whatsapp = is_kw ? '96566144477' : '97460010506' %}
{% set instagram = is_kw ? 'https://www.instagram.com/limitedoud.kw/' : 'https://instagram.com/limitedoud' %}
<footer data-testid="store-footer" class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="{{ 'images/limited-oud/logo.png'|asset }}" alt="Limited Oud" class="logo-img" style="width:58px;height:58px">
      <p>عود فاخر للذوق الرفيع — أدهان عود، توزيعات، وهدايا مختارة بعناية.</p>
      <div class="footer-social">
        <a href="{{ instagram }}" aria-label="انستقرام"><svg viewBox="0 0 24 24" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg></a>
        <a href="https://wa.me/{{ whatsapp }}" aria-label="واتساب"><svg viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.4-4.2A8 8 0 1 1 8.6 19L4 20z"/><path d="M9 10c0 3 2.5 5.5 5.5 5.5"/></svg></a>
      </div>
    </div>
    <div><div class="footer-title">المتجر</div><ul class="footer-links"><li><a href="/#products">جميع المنتجات</a></li><li><a href="/#perfume">العطور</a></li><li><a href="/#oud">العود</a></li></ul></div>
    <div><div class="footer-title">عن Limited Oud</div><ul class="footer-links"><li><a href="/#about">قصتنا</a></li>{% if not is_kw %}<li><a href="/#shipping">سياسة الشحن</a></li><li><a href="/#returns">سياسة الاستبدال</a></li><li><a href="/#privacy">سياسة الخصوصية</a></li><li><a href="/#terms">الشروط والأحكام</a></li>{% endif %}</ul></div>
    <div><div class="footer-title">تواصل معنا</div><ul class="footer-links"><li><a href="/#contact">راسلنا</a></li><li><a href="https://wa.me/{{ whatsapp }}">واتساب</a></li><li><a href="{{ instagram }}">{{ is_kw ? 'instagram.com/limitedoud.kw' : 'instagram.com/limitedoud' }}</a></li></ul></div>
  </div>
  <div class="container footer-bottom"><span>© Limited Oud — جميع الحقوق محفوظة</span><span>{{ is_kw ? 'صُنع بفخامة لسوق الكويت 🇰🇼' : 'صُنع بفخامة لسوق قطر 🇶🇦' }}</span></div>
</footer>
