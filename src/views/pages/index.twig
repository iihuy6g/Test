{% extends "layouts.master" %}
{% block content %}
<div class="limited-home">
<section class="hero">
  <div class="hero-content">
    <div class="hero-bottle"><svg viewBox="0 0 64 64" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="24" y="10" width="16" height="9" rx="1.5"/>
      <path d="M27 19h10l3 6v25a3 3 0 0 1-3 3H27a3 3 0 0 1-3-3V25l3-6z"/>
      <path d="M24 34h16"/>
      <path d="M28 7h8"/>
    </svg></div>
    <div class="hero-eyebrow">LIMITED OUD</div>
    <h1>عطور صُممت<br>لتترك أثرًا</h1>
    <p>عود فاخر للذوق الرفيع — أدهان عود أصيلة، عطور مركّبة بعناية، ومجموعات هدايا تُختار لتُروى قصتها لا لتُنسى رائحتها فقط.</p>
    <div class="hero-actions">
      <a href="#products" class="btn gold">اكتشف المجموعة</a>
      <a href="#about" class="btn outline" style="color:var(--cream);border-color:rgba(248,243,233,.5)">قصة العلامة</a>
    </div>
  </div>
</section>
<section class="section sand" id="collections"><div class="container"><div class="eyebrow reveal">COLLECTIONS</div><h2 class="section-title reveal">تسوّق حسب المجموعة</h2><div class="grid cols-4"><a href="#products" id="perfume" class="collection reveal">
          <svg viewBox="0 0 64 64" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="24" y="10" width="16" height="9" rx="1.5"/>
      <path d="M27 19h10l3 6v25a3 3 0 0 1-3 3H27a3 3 0 0 1-3-3V25l3-6z"/>
      <path d="M24 34h16"/>
      <path d="M28 7h8"/>
    </svg>
          <div><div class="collection-name">عطور</div><div class="collection-count" data-qa-count="5" data-kw-count="0">5 منتجًا</div></div>
        </a><a href="#products" id="oud" class="collection reveal">
          <svg viewBox="0 0 64 64" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 40l9-20 6 4-8 20z"/>
      <path d="M27 42l7-24 6 5-9 22z"/>
      <path d="M39 41l6-18 6 6-9 15z"/>
      <path d="M14 40h34"/>
    </svg>
          <div><div class="collection-name">العود</div><div class="collection-count" data-qa-count="28" data-kw-count="5">28 منتجًا</div></div>
        </a><a href="#products" id="oilbrand" class="collection reveal">
          <svg viewBox="0 0 64 64" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M32 6v16"/>
      <rect x="27" y="6" width="10" height="7" rx="1.5"/>
      <path d="M24 22h16l-2 10a6 6 0 0 1-12 0l-2-10z"/>
      <path d="M32 32v22"/>
    </svg>
          <div><div class="collection-name">أدهان العود</div><div class="collection-count" data-qa-count="11" data-kw-count="3">11 منتجًا</div></div>
        </a><a href="#products" id="gift" class="collection reveal">
          <svg viewBox="0 0 64 64" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="10" y="24" width="44" height="30" rx="1.5"/>
      <path d="M10 34h44"/>
      <path d="M32 24v30"/>
      <path d="M18 24c0-7 5-14 14-14s14 7 14 14"/>
    </svg>
          <div><div class="collection-name">مجموعات وهدايا</div><div class="collection-count" data-qa-count="1" data-kw-count="0">1 منتجًا</div></div>
        </a></div></div></section>
<section class="section tight limited-products" id="products"><div class="container">
  <div class="eyebrow">PRODUCTS</div>
  <h2 class="section-title">منتجاتنا</h2>
  <p class="section-sub">اكتشف مجموعتنا من العطور والعود وأدهان العود.</p>
  <salla-products-list source="latest" data-testid="limited-oud-home-products"></salla-products-list>
  <div class="limited-products-more"><a class="btn outline" href="#collections">تصفح المجموعات</a></div>
</div></section>
<section class="section sand" id="about"><div class="container story">
      <div class="story-text reveal">
        <div class="eyebrow">OUR STORY</div>
        <h2>رحلة في عالم العطر والعود</h2>
        <p>بدأت Limited Oud من شغف حقيقي بالعود الأصيل، وسعي دؤوب للوصول إلى أدق الخامات من غابات الهند وفيتنام وكمبوديا ولاوس، لنقدّم لكم تجربة فاخرة تليق بذوقكم.</p>
        <p>كل قطعة عود وكل قطرة دهن تمرّ بعناية فائقة قبل أن تصل إليكم، لتحمل معها عبق الأصالة وفخامة التفاصيل.</p>
        <a href="#contact" class="btn outline">تواصل معنا</a>
      </div>
    </div></section><section class="section" id="notes"><div class="container">
      <div class="eyebrow reveal">FRAGRANCE EXPERIENCE</div>
      <h2 class="section-title reveal">رحلة العطر</h2>
      <p class="section-sub reveal">كل عطر يُروى على ثلاث طبقات متتالية، تتكشف مع الوقت لتمنحك تجربة متكاملة.</p>
      <div class="notes-wrap">
        <div class="note-item reveal">
          <div class="note-circle"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10 30C8 16 18 8 32 8c0 14-8 24-22 22z"/>
      <path d="M11 29 26 11"/>
    </svg></div>
          <div class="note-label">TOP NOTES</div>
          <div class="note-title">الافتتاحية</div>
          <p class="note-desc">أولى الانطباعات — نضارة تلامس الحواس فور الاستخدام.</p>
        </div>
        <div class="note-item reveal">
          <div class="note-circle"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="20" cy="20" r="4.5"/>
      <path d="M20 4c4 0 6 3 6 7s-2 6-6 6-6-2-6-6 2-7 6-7z"/>
      <path d="M20 36c4 0 6-3 6-7s-2-6-6-6-6 2-6 6 2 7 6 7z"/>
      <path d="M4 20c0-4 3-6 7-6s6 2 6 6-2 6-6 6-7-2-7-6z"/>
      <path d="M36 20c0 4-3 6-7 6s-6-2-6-6 2-6 6-6 7 2 7 6z"/>
    </svg></div>
          <div class="note-label">HEART NOTES</div>
          <div class="note-title">قلب العطر</div>
          <p class="note-desc">جوهر الرائحة، حيث تتكشف الشخصية الحقيقية للعطر.</p>
        </div>
        <div class="note-item reveal">
          <div class="note-circle"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 6c6 9 10 14 10 19a10 10 0 0 1-20 0c0-5 4-10 10-19z"/>
    </svg></div>
          <div class="note-label">BASE NOTES</div>
          <div class="note-title">القاعدة</div>
          <p class="note-desc">الأثر الذي يبقى، ثبات دافئ يرافقك لساعات طويلة.</p>
        </div>
      </div>
    </div></section><section class="section dark"><div class="container">
      <div class="eyebrow reveal" style="color:var(--gold-soft)">WHY LIMITED OUD</div>
      <h2 class="section-title reveal">لماذا Limited Oud</h2>
      <div class="why-grid">
        <div class="why-item reveal"><span class="seal"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 5 25 15 36 17 28 25 30 36 20 30 10 36 12 25 4 17 15 15z"/>
    </svg></span><h4>جودة عالية</h4><p>خامات مختارة من أرقى غابات العود حول العالم.</p></div>
        <div class="why-item reveal"><span class="seal"><svg viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3 20 6v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg></span><h4>عطور مختارة بعناية</h4><p>كل قطعة تمر بفحص دقيق قبل أن تصل إليك.</p></div>
        <div class="why-item reveal"><span class="seal"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="13" width="19" height="14" rx="1.5"/>
      <path d="M22 18h8l6 6v3h-14z"/>
      <circle cx="12" cy="30" r="3"/><circle cx="29" cy="30" r="3"/>
    </svg></span><h4>شحن داخل قطر</h4><p>توصيل مخصص لعملائنا داخل دولة قطر.</p></div>
        <div class="why-item reveal"><span class="seal"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <rect x="7" y="14" width="26" height="20" rx="1.5"/>
      <path d="M7 22h26"/><path d="M20 14v20"/>
      <path d="M20 14c-3-6 2-9 4-6-2-3 3-6 4 0"/>
    </svg></span><h4>تغليف فاخر</h4><p>تغليف يليق بفخامة المنتج وقيمة الهدية.</p></div>
        <div class="why-item reveal"><span class="seal"><svg viewBox="0 0 40 40" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 22v-3a14 14 0 0 1 28 0v3"/>
      <rect x="4" y="22" width="7" height="10" rx="2"/>
      <rect x="29" y="22" width="7" height="10" rx="2"/>
      <path d="M36 32c0 4-4 6-9 6"/>
    </svg></span><h4>خدمة عملاء</h4><p>فريق مخصص لمرافقتكم من الاختيار حتى الاستلام.</p></div>
      </div>
    </div></section><section class="section sand"><div class="container"><div class="eyebrow reveal">FAQ</div><h2 class="section-title reveal">أسئلة شائعة</h2><div class="faq reveal"><div class="faq-item">
          <button class="faq-q"><span>ما هي مناطق التوصيل؟</span><svg viewBox="0 0 20 20" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 3v14M3 10h14"/>
    </svg></button>
          <div class="faq-a"><p>نوفر التوصيل داخل {{ theme.settings.get('store_country', 'QA') == 'KW' ? 'الكويت' : 'دولة قطر' }} لجميع المناطق، مع إمكانية التوصيل السريع حسب المنطقة.</p></div>
        </div><div class="faq-item">
          <button class="faq-q"><span>ما هي طرق الدفع المتاحة؟</span><svg viewBox="0 0 20 20" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 3v14M3 10h14"/>
    </svg></button>
          <div class="faq-a"><p>الدفع عند الاستلام، أو التحويل البنكي، بالإضافة إلى وسائل الدفع الإلكتروني المتاحة قريبًا.</p></div>
        </div><div class="faq-item">
          <button class="faq-q"><span>هل يمكن استبدال المنتج؟</span><svg viewBox="0 0 20 20" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 3v14M3 10h14"/>
    </svg></button>
          <div class="faq-a"><p>نعم، يمكن استبدال المنتج خلال 3 أيام من الاستلام بشرط أن يكون بحالته الأصلية.</p></div>
        </div><div class="faq-item">
          <button class="faq-q"><span>كم تستغرق مدة التوصيل؟</span><svg viewBox="0 0 20 20" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 3v14M3 10h14"/>
    </svg></button>
          <div class="faq-a"><p>عادة ما يصل طلبكم خلال 1-3 أيام عمل داخل {{ theme.settings.get('store_country', 'QA') == 'KW' ? 'الكويت' : 'قطر' }}.</p></div>
        </div><div class="faq-item">
          <button class="faq-q"><span>هل المنتجات أصلية؟</span><svg viewBox="0 0 20 20" stroke-width="1.6" stroke-linecap="round">
      <path d="M10 3v14M3 10h14"/>
    </svg></button>
          <div class="faq-a"><p>جميع منتجاتنا مصدرها مباشر من الخامات الأصيلة، ونحن مرخصون من وزارة التجارة والصناعة.</p></div>
        </div></div></div></section>
{% if theme.settings.get('store_country', 'QA') == 'QA' %}
<section class="section sand limited-info" id="store-information"><div class="container">
  <div class="eyebrow">INFORMATION</div><h2 class="section-title">معلومات المتجر</h2>
  <div class="limited-info-grid">
    <article id="shipping"><h3>سياسة الشحن</h3><p>نوفر خدمة التوصيل داخل دولة قطر لجميع المناطق. يستغرق التوصيل عادة من 1 إلى 3 أيام عمل من تاريخ تأكيد الطلب.</p><p>الدوحة، الريان، الوكرة، الخور، أم صلال، الشمال، وجميع مناطق دولة قطر. شحن مجاني داخل قطر لجميع الطلبات.</p></article>
    <article id="returns"><h3>سياسة الاستبدال</h3><p>يحق للعميل طلب استبدال المنتج خلال 3 أيام من تاريخ الاستلام، بشرط أن يكون بحالته الأصلية وغير مستخدم. يرجى التواصل مع خدمة العملاء عبر واتساب لبدء الإجراءات.</p></article>
    <article id="privacy"><h3>سياسة الخصوصية</h3><p>نحترم خصوصية عملائنا، ولا نشارك بياناتكم الشخصية مع أي جهة خارجية إلا بالقدر اللازم لإتمام الشحن والتوصيل. نستخدم الاسم ورقم الهاتف والعنوان والبريد الإلكتروني لتنفيذ الطلبات والتواصل معكم.</p></article>
    <article id="terms"><h3>الشروط والأحكام</h3><p>جميع الأسعار المعروضة بالريال القطري (QAR) وشاملة لجميع الرسوم ما لم يُذكر خلاف ذلك. يحق للمتجر رفض أو إلغاء أي طلب عند تقديم معلومات غير صحيحة أو عدم توفر المنتج.</p></article>
  </div>
</div></section>
{% endif %}
{% set is_kw = theme.settings.get('store_country', 'QA') == 'KW' %}
<section class="section limited-contact" id="contact"><div class="container">
  <div class="eyebrow">CONTACT US</div><h2 class="section-title">تواصل معنا</h2>
  <div class="limited-contact-links">
    <a class="btn gold" href="https://wa.me/{{ is_kw ? '96566144477' : '97460010506' }}">واتساب {{ is_kw ? '+96566144477' : '+97460010506' }}</a>
    <a class="btn outline" href="{{ is_kw ? 'https://www.instagram.com/limitedoud.kw/' : 'https://instagram.com/limitedoud' }}">إنستغرام {{ is_kw ? '@limitedoud.kw' : '@limitedoud' }}</a>
  </div>
</div></section>
</div>
{% endblock %}
